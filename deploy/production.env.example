# Sao chép thành biến môi trường trên server (KHÔNG commit file có giá trị thật)
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__Default=Server=...;Database=WatchShop;User Id=watchshop_app;Password=...;Encrypt=True;TrustServerCertificate=True
Jwt__Key=<chuỗi ngẫu nhiên >= 32 ký tự>
Admin__Username=admin
Admin__Password=<mật khẩu mạnh, chỉ dùng lần tạo đầu>
Cors__Origins__0=https://tenmiencuaban.vn
Payment__AccountNumber=<số tài khoản thật>
Payment__AccountName=<TEN CHU TAI KHOAN>
